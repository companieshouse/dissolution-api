{
  "widgets": [
    {
      "type": "log",
      "x": 0,
      "y": 7,
      "width": 12,
      "height": 6,
      "properties": {
        "query": "SOURCE \"${dissolution_api_log_group_arn}\" |\nfields @timestamp as Time, data.message as `Error Message`\n| filter event = \"error\"\n| sort @timestamp desc\n| limit 100",
        "region": "${region}",
        "stacked": false,
        "view": "table",
        "title": "dissolution-api errors"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "# Transactions Flow Metrics\n\n",
        "background": "transparent"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 6,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "# Logs\n\n",
        "background": "transparent"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 1,
      "width": 6,
      "height": 5,
      "properties": {
        "metrics": [
          [ "ECS/AWSOTel/Application", "http.server.requests", "exception", "none", "method", "POST", "error", "none", "uri", "/company/{company-number}/transactions/{transaction_id}/dissolution", "outcome", "SUCCESS", "status", "201", { "region": "${region}" } ],
          [ "...", "CLIENT_ERROR", ".", "404", { "region": "${region}" } ],
          [ "...", "409", { "region": "${region}" } ],
          [ "...", "400", { "region": "${region}" } ]
        ],
        "sparkline": true,
        "view": "singleValue",
        "region": "${region}",
        "stacked": false,
        "title": "Draft Dissolution Requests",
        "period": 300,
        "stat": "SampleCount"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 7,
      "width": 12,
      "height": 6,
      "properties": {
        "query": "SOURCE \"${dissolution_web_log_group_arn}\" |\nfields @timestamp as Time, data.message as `Error Message`\n| filter event = \"error\"\n| sort @timestamp desc\n| limit 100",
        "region": "${region}",
        "stacked": false,
        "view": "table",
        "title": "dissolution-web errors"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 13,
      "width": 12,
      "height": 6,
      "properties": {
        "query": "SOURCE \"${transactions_api_log_group_arn}\" |\nfields @timestamp as Time, data.message as `Error Message`\n| filter event = \"error\"\n| sort @timestamp desc\n| limit 100",
        "region": "${region}",
        "stacked": false,
        "view": "table",
        "title": "transactions-api errors"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 13,
      "width": 12,
      "height": 6,
      "properties": {
        "query": "SOURCE \"${chips_filing_consumer_log_group_arn}\" |\nfields @timestamp as Time, data.message as `Error Message`\n| filter event = \"error\"\n| sort @timestamp desc\n| limit 100",
        "region": "${region}",
        "stacked": false,
        "view": "table",
        "title": "chips-filing-consumer errors"
      }
    }
  ]
}
